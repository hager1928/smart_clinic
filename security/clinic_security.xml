<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- doctor -->
    <record id="group_doctor" model="res.groups">
        <field name="name">Doctor</field>
    </record>

    <record id="group_doctor_manager" model="res.groups">
        <field name="name">Doctor Manager</field>
    </record>
<!-- patient -->
    <record id="group_patient" model="res.groups">
        <field name="name">Patient</field>
    </record>

    <record id="group_patient_manager" model="res.groups">
        <field name="name">Patient Manager</field>
    </record>
<!-- patient appointments -->
    <record id="group_patient_appointment" model="res.groups">
        <field name="name">Patient Appointment</field>
    </record>

    <record id="group_patient_appointment_manager" model="res.groups">
        <field name="name">Patient Appointment Manager</field>
    </record>
<!-- Doctor Appointments -->
    <record id="group_doctor_appointment" model="res.groups">
        <field name="name">Doctor Appointment</field>
    </record>

    <record id="group_doctor_appointment_manager" model="res.groups">
        <field name="name">Doctor Appointment Manager</field>
    </record>
<!-- doctor -->
    <record id="doctor_user_rule" model="ir.rule">
        <field name="name">Related User: Own Doctor Only</field>
        <field name="model_id" ref="model_clinic_doctor"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field> 
        <field name="groups" eval="[(4, ref('group_doctor'))]"/>
    </record>

    <record id="doctor_manager_user_rule" model="ir.rule">
        <field name="name">Related User: Own Doctor Only</field>
        <field name="model_id" ref="model_clinic_doctor"/>
        <field name="domain_force">[]</field> 
        <field name="groups" eval="[(4, ref('group_doctor_manager'))]"/>
    </record>
<!-- patient -->
    <record id="patient_user_rule" model="ir.rule">
        <field name="name">Related User: Own Patient Only</field>
        <field name="model_id" ref="model_clinic_patient"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field> 
        <field name="groups" eval="[(4, ref('group_patient'))]"/>
    </record>

    <record id="patient_manager_user_rule" model="ir.rule">
        <field name="name">Related User: Own Patient Only</field>
        <field name="model_id" ref="model_clinic_patient"/>
        <field name="domain_force">[]</field> 
        <field name="groups" eval="[(4, ref('group_patient_manager'))]"/>
    </record>
<!-- patient appointments -->
    <record id="patient_appointment_user_rule" model="ir.rule">
        <field name="name">Related User: Own Patient Appointment Only</field>
        <field name="model_id" ref="model_clinic_appointment"/>
        <field name="domain_force">[('patient_id.user_id', '=', user.id)]</field> 
        <field name="groups" eval="[(4, ref('group_patient_appointment'))]"/>
    </record>

    <record id="patient_appointment_manager_user_rule" model="ir.rule">
        <field name="name">Related User: Own Patient Appointment Only</field>
        <field name="model_id" ref="model_clinic_appointment"/>
        <field name="domain_force">[]</field> 
        <field name="groups" eval="[(4, ref('group_patient_appointment_manager'))]"/>
    </record>
<!-- doctor appointments -->
    <record id="doctor_appointment_user_rule" model="ir.rule">
        <field name="name">Related User: Own Doctor Appointment Only</field>
        <field name="model_id" ref="model_clinic_appointment"/>
        <field name="domain_force">[('doctor_id.user_id', '=', user.id)]</field> 
        <field name="groups" eval="[(4, ref('group_doctor_appointment'))]"/>
    </record>

    <record id="doctor_appointment_manager_user_rule" model="ir.rule">
        <field name="name">Related User: Own Doctor Appointment Only</field>
        <field name="model_id" ref="model_clinic_appointment"/>
        <field name="domain_force">[]</field> 
        <field name="groups" eval="[(4, ref('group_doctor_appointment_manager'))]"/>
    </record>
</odoo>
