<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard View -->
    <record id="view_reserve_appointment_wizard_form" model="ir.ui.view">
        <field name="name">reserve.appointment.wizard.form</field>
        <field name="model">reserve.appointment.wizard</field>
        <field name="arch" type="xml">
            <form string="Reserve Appointment">
                <group>
                    <group>
                        <field name="patient_id"/>
                        <field name="doctor_id"/>
                    </group>
                    <group>
                        <field name="start_time"/>
                        <field name="end_time"/>
                    </group>
                </group>
                <!-- <group string="Description of Issue">
                    <field name="description" placeholder="Describe the issue in detail..."/>
                </group> -->
                <footer>
                    <button name="action_submit_request_reservation" string="Submit Request" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_reserve_appointment_wizard" model="ir.actions.act_window">
        <field name="name">Reserve Appointment</field>
        <field name="res_model">reserve.appointment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>